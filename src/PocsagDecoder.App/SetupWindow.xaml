<Window x:Class="PocsagDecoder.App.SetupWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="POCSAG Decoder einrichten" Width="700" Height="590" MinWidth="620" MinHeight="540" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,22"><TextBlock x:Name="ProgressLabel" Style="{StaticResource Eyebrow}"/><TextBlock x:Name="StepTitle" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/><TextBlock Text="Schritt für Schritt zum ersten Empfang." Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="ValidationMessage" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,10,0,14" AutomationProperties.LiveSetting="Polite"/>
            <DockPanel><Button Content="Abbrechen" Click="Cancel_Click" DockPanel.Dock="Left"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BackButton" Content="Zurück" Click="Back_Click"/><Button x:Name="NextButton" Content="Weiter" Click="Next_Click" Style="{StaticResource PrimaryButton}" Padding="18,8" IsDefault="True"/></StackPanel></DockPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="ReceiverPage">
                    <TextBlock Text="Stecke deinen RTL-SDR-Stick ein. Der WinUSB-Treiber muss bereits mit Zadig eingerichtet sein." TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <CheckBox x:Name="CustomModeBox" Content="Ich verwende einen eigenen Empfangsbefehl" Margin="0,0,0,16"/>
                    <TextBlock Text="rtl_fm.exe" Margin="0,0,0,5"/>
                    <DockPanel Margin="0,0,0,12"><Button Content="Auswählen…" Click="BrowseRtl_Click" DockPanel.Dock="Right"/><TextBox x:Name="RtlPathBox" AutomationProperties.Name="Pfad zu rtl_fm.exe"/></DockPanel>
                    <TextBlock Text="multimon-ng.exe" Margin="0,0,0,5"/>
                    <DockPanel Margin="0,0,0,12"><Button Content="Auswählen…" Click="BrowseMultimon_Click" DockPanel.Dock="Right"/><TextBox x:Name="MultimonPathBox" AutomationProperties.Name="Pfad zu multimon-ng.exe"/></DockPanel>
                    <TextBlock Text="Eigener Befehl (nur bei aktivierter Option)" Margin="0,0,0,5"/>
                    <TextBox x:Name="CustomCommandBox" TextWrapping="Wrap" MinHeight="55" AutomationProperties.Name="Eigener Empfangsbefehl"/>
                </StackPanel>
                <StackPanel x:Name="FrequencyPage" Visibility="Collapsed">
                    <TextBlock Text="Welche Frequenz möchtest du empfangen?" FontSize="17" Margin="0,0,0,18"/>
                    <TextBlock Text="Frequenz in MHz" Margin="0,0,0,5"/>
                    <TextBox x:Name="FrequencyBox" MaxWidth="180" HorizontalAlignment="Left" FontSize="22" AutomationProperties.Name="Empfangsfrequenz in MHz"/>
                    <TextBlock Text="Beispiel: 173,255. Komma und Punkt sind erlaubt." Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,18"/>
                    <TextBlock Text="POCSAG-Geschwindigkeiten" Margin="0,0,0,7"/>
                    <WrapPanel><CheckBox x:Name="Baud512" Content="512 Baud" Margin="0,0,18,0"/><CheckBox x:Name="Baud1200" Content="1200 Baud" Margin="0,0,18,0"/><CheckBox x:Name="Baud2400" Content="2400 Baud"/></WrapPanel>
                    <TextBlock Text="Gain, Frequenzkorrektur und weitere Empfangsoptionen findest du später unter Einstellungen → Empfang. Bei einem eigenen Befehl gelten dessen Frequenz- und Decoderparameter." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,0"/>
                </StackPanel>
                <StackPanel x:Name="ForwardingPage" Visibility="Collapsed">
                    <TextBlock Text="Meldungen weiterleiten – oder erst einmal nur empfangen." FontSize="16" TextWrapping="Wrap" Margin="0,0,0,18"/>
                    <CheckBox x:Name="WebhookBox" Content="Webhook anlegen und Weiterleitung aktivieren" Margin="0,0,0,18"/>
                    <StackPanel IsEnabled="{Binding IsChecked, ElementName=WebhookBox}">
                        <TextBlock Text="Name der Schnittstelle" Margin="0,0,0,5"/><TextBox x:Name="WebhookNameBox" Text="Mein Webhook" Margin="0,0,0,12"/>
                        <TextBlock Text="Webhook-Adresse (HTTP oder HTTPS)" Margin="0,0,0,5"/><TextBox x:Name="WebhookUrlBox" AutomationProperties.Name="Webhook-Adresse"/>
                        <TextBlock Text="Nach dem Start werden alle empfangenen Meldungen als JSON an diese Adresse gesendet. Du kannst die Auswahl später unter Ereignisse auf bestimmte RICs einschränken." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0"/>
                    </StackPanel>
                    <TextBlock Text="MQTT, Telegram, E-Mail und weitere Ziele legst du später unter Schnittstellen an. Der Assistent sendet keine Testnachricht." TextWrapping="Wrap" Margin="0,24,0,0"/>
                </StackPanel>
                <StackPanel x:Name="SummaryPage" Visibility="Collapsed">
                    <Border Style="{StaticResource DashboardCard}"><TextBlock x:Name="SummaryText" TextWrapping="Wrap" FontSize="15" LineHeight="27"/></Border>
                    <TextBlock Text="Mit „Einrichtung speichern“ werden die Einstellungen übernommen. Starte den Empfang anschließend über „Empfang starten“." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,20,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
