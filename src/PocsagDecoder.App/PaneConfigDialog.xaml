<Window x:Class="PocsagDecoder.App.PaneConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fenster konfigurieren" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,10"
                   Text="Änderungen wirken sofort und werden automatisch gespeichert. Leere Felder filtern nicht." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Name" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Margin="0,3" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Text="Ereignis" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,3" ItemsSource="{Binding EventChoices}" SelectedItem="{Binding Event}"
                      ToolTip="Nur Telegramme anzeigen, die zu diesem Telegrammereignis passen" />
            <TextBlock Grid.Row="2" Text="RIC" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,3" Text="{Binding Ric, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Teil einer RIC, oder Muster wie 12345*, 1000000-1000999, 111,222" />
            <TextBlock Grid.Row="3" Text="SubRIC" FontWeight="SemiBold" VerticalAlignment="Center" />
            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,3" Width="80" HorizontalAlignment="Left"
                      ItemsSource="{Binding SubRicChoices}" SelectedItem="{Binding SubRic}" />
            <TextBlock Grid.Row="4" Text="Bezeichnung/Ort" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,3" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Sucht in Bezeichnung, Bezeichnung kurz, Ort und SubRIC-Bedeutung. Mehrere Begriffe mit | trennen." />
            <TextBlock Grid.Row="5" Text="Text" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBox Grid.Row="5" Grid.Column="1" Margin="0,3" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,6,0,0">
                <CheckBox Content="nur Ereignistreffer" IsChecked="{Binding OnlyMatched}" />
                <CheckBox Content="Wiederholungen ausblenden" IsChecked="{Binding HideRepeats}" Margin="0,4,0,0"
                          ToolTip="Blendet Meldungen aus, die mit gleicher RIC, SubRIC und gleichem Text kurz vorher schon kamen (Zeitraum wie unter Telegrammereignisse eingestellt, sonst 30 Sekunden)." />
            </StackPanel>
        </Grid>

        <TextBlock Text="Spalten" FontWeight="SemiBold" Margin="0,14,0,4" />
        <ItemsControl x:Name="ColumnList">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Visible}" Margin="0,2" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Schließen" IsDefault="True" IsCancel="True" Click="Close_Click" FontWeight="SemiBold" />
        </StackPanel>
    </StackPanel>
</Window>
