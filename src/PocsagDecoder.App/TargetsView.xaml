<UserControl x:Class="PocsagDecoder.App.TargetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PocsagDecoder.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Farbiges Symbol der Schnittstellen-Art -->
        <DataTemplate x:Key="KindTile">
            <Border Width="34" Height="34" CornerRadius="8" Background="{Binding KindColor}">
                <TextBlock Style="{StaticResource IconGlyph}" FontSize="16" Text="{Binding KindIcon}" />
            </Border>
        </DataTemplate>

        <!-- Punkt für das Ergebnis des letzten Versands -->
        <Style x:Key="StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Fill" Value="#C3C9D1" />
            <Setter Property="ToolTip" Value="{Binding LastResult}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LastSuccess}" Value="True">
                    <Setter Property="Fill" Value="#16A34A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LastSuccess}" Value="False">
                    <Setter Property="Fill" Value="#DC2626" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TargetItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#9CA3AF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FDF2F2" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Schnittstelle deaktiviert: Eintrag blasser darstellen -->
        <Style x:Key="FadeWhenDisabled" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Liste ===================== -->
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Margin="0" Click="AddTarget_Click"
                        ToolTip="Neue Schnittstelle anlegen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE710;" FontSize="11" Margin="0,0,6,0" />
                        <TextBlock Text="Neu" />
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Schnittstellen" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0">
                        <Run Text="{Binding Targets.Count, Mode=OneWay}" /><Run Text=" eingerichtet" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource TargetItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Style="{StaticResource FadeWhenDisabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource KindTile}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,1,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                    <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Summary, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="2" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}" VerticalAlignment="Center"
                                      ToolTip="Schnittstelle an/aus" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===================== Kein Eintrag gewählt ===================== -->
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedTarget}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE968;" FontSize="40" Foreground="#C3C9D1" />
                <TextBlock Text="Keine Schnittstelle ausgewählt" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="Links eine Schnittstelle auswählen oder mit „Neu“ anlegen." />
            </StackPanel>
        </Border>

        <!-- ===================== Editor ===================== -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" x:Name="EditorScroll"
                      Visibility="{Binding SelectedTarget, Converter={x:Static local:TargetsView.NotNullToVis}}">
            <StackPanel DataContext="{Binding SelectedTarget}" Margin="0,0,10,10"
                        x:Name="Editor" GotKeyboardFocus="Editor_GotKeyboardFocus">

                <!-- Kopf -->
                <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="52" Height="52" CornerRadius="12" Background="{Binding KindColor}" VerticalAlignment="Top">
                                <TextBlock Style="{StaticResource IconGlyph}" FontSize="24" Text="{Binding KindIcon}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,12,0">
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" FontSize="18" FontWeight="SemiBold"
                                         BorderThickness="0,0,0,1" Background="Transparent" Padding="0,2"
                                         ToolTip="Name der Schnittstelle (wird bei den Telegrammereignissen ausgewählt)" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <ComboBox MinWidth="170" ItemsSource="{Binding DataContext.TargetKindChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedItem="{Binding DataContext.SelectedTargetKind, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ToolTip="Art der Schnittstelle" />
                                    <CheckBox Style="{StaticResource Switch}" Content="Aktiv" IsChecked="{Binding Enabled}" Margin="14,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <Button Style="{StaticResource PrimaryButton}" Click="Test_Click" ToolTip="Testnachricht an diese Schnittstelle senden (mit Sicherheitsabfrage)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE724;" FontSize="12" Margin="0,0,6,0" />
                                        <TextBlock Text="Testen" />
                                    </StackPanel>
                                </Button>
                                <Button Click="Duplicate_Click" MinWidth="0" Padding="8,4" ToolTip="Duplizieren">
                                    <TextBlock Style="{StaticResource IconGlyph}" Foreground="{StaticResource TextBrush}" Text="&#xE8C8;" FontSize="13" />
                                </Button>
                                <Button Click="Delete_Click" MinWidth="0" Padding="8,4" Margin="0" ToolTip="Löschen">
                                    <TextBlock Style="{StaticResource IconGlyph}" Foreground="{StaticResource AccentBrush}" Text="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <Border Background="#F7F8FA" CornerRadius="6" Padding="10,7" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Statistics}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" Margin="17,2,0,0" Text="{Binding LastResult, StringFormat=Zuletzt: {0}}"
                                           Visibility="{Binding LastSuccess, Converter={x:Static local:TargetsView.NotNullToVis}}" />
                                <TextBlock Margin="17,2,0,0"
                                           Text="{Binding DataContext.TargetTestResult, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Style="{StaticResource Hint}" Margin="17,2,0,0"
                                           Text="{Binding DataContext.SelectedTargetUsedBy, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </StackPanel>
                        </Border>

                        <!-- Hinweis zur Art -->
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconGlyph}" Foreground="#2563EB" Text="&#xE946;" FontSize="14"
                                       VerticalAlignment="Top" Margin="2,1,8,0" />
                            <TextBlock Text="{Binding KindHint}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- Verbindung -->
                <GroupBox Header="Verbindung">
                    <StackPanel>
                        <StackPanel Visibility="{Binding UsesUrl, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UrlLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Width="85" Margin="0,0,6,0" Visibility="{Binding UsesHttp, Converter={StaticResource BoolToVis}}"
                                          ItemsSource="{Binding DataContext.HttpMethods, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding Method}" />
                                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Visibility="{Binding UsesHttp, Converter={StaticResource BoolToVis}}"
                                       Text="Platzhalter sind auch in der URL erlaubt (werden URL-kodiert), z. B. …?ric={ric}&amp;text={message}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesHost, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding HostLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                                <TextBox Grid.Column="2" Text="{Binding Port}" ToolTip="Port (0 = Standard)" />
                            </Grid>
                            <CheckBox Style="{StaticResource Switch}" Content="Verschlüsselt (TLS)" IsChecked="{Binding UseTls}" Margin="0,8,0,0"
                                      Visibility="{Binding UsesTls, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesFile, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding FileLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Durchsuchen…" Margin="6,0,0,0" Click="BrowseFile_Click" />
                                <TextBox Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesArguments, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Argumente" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            <TextBlock Style="{StaticResource Hint}" Text="z. B. &quot;{ric}&quot; &quot;{subric}&quot; &quot;{message}&quot;" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesToken, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TokenLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesSender, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SenderLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Sender, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesRecipient, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding RecipientLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesTopic, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Topic" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            <CheckBox Style="{StaticResource Switch}" Content="Retain (letzte Meldung bleibt am Broker gespeichert)" IsChecked="{Binding Retain}" Margin="0,8,0,0" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding UsesPriority, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PriorityLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Width="70" HorizontalAlignment="Left" Text="{Binding Priority}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Anmeldung -->
                <GroupBox Header="Anmeldung" Visibility="{Binding UsesPassword, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Visibility="{Binding UsesLogin, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Benutzername" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding PasswordLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding PasswordLabel}" />
                                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}" Text="Wird unverschlüsselt in der settings.json gespeichert." />
                    </StackPanel>
                </GroupBox>

                <!-- Inhalt -->
                <GroupBox Visibility="{Binding UsesContent, Converter={StaticResource BoolToVis}}">
                    <GroupBox.Header>
                        <DockPanel LastChildFill="False" Margin="0,-2">
                            <TextBlock DockPanel.Dock="Left" Text="Inhalt" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Margin="0" Click="Placeholders_Click"
                                    ToolTip="Platzhalter an der Cursor-Position einfügen">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{}{ }" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,6,0" />
                                    <TextBlock Text="Platzhalter einfügen" FontWeight="Normal" />
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </GroupBox.Header>
                    <StackPanel>
                        <StackPanel Visibility="{Binding UsesTitle, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TitleLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding TitleTemplate, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding UsesText, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding TextLabel}" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TextTemplate, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="96" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding UsesBody, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding BodyLabel}" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding BodyTemplate, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                     MinHeight="180" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top" />
                            <TextBlock Style="{StaticResource Hint}" Text="Bei JSON werden die Werte automatisch JSON-sicher eingesetzt (Anführungszeichen, Zeilenumbrüche)." />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Erweitert -->
                <Expander Visibility="{Binding UsesAdvanced, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                    <Expander.Header>
                        <TextBlock Text="Erweitert" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8,12,12" Margin="0,6,0,0">
                        <StackPanel>
                            <StackPanel Visibility="{Binding UsesHttp, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Content-Type" Style="{StaticResource FieldLabel}" Margin="0,0,0,3" />
                                <ComboBox IsEditable="True" Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding DataContext.ContentTypes, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                <TextBlock Text="Zusätzliche Header (eine Zeile je Header, „Name: Wert“)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Headers, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="56"
                                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top" />
                                <TextBlock Style="{StaticResource Hint}" Text="z. B. Authorization: Bearer DEIN_TOKEN" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding UsesTimeout, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Timeout (s)" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="50" Text="{Binding TimeoutSeconds}" />
                                <TextBlock Text="Wiederholungen bei Fehler" VerticalAlignment="Center" Margin="18,0,6,0" />
                                <TextBox Width="50" Text="{Binding Retries}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Expander>

                <TextBlock Style="{StaticResource Hint}" Margin="2,0,0,0"
                           Text="„Testen“ verwendet RIC, SubRIC und Text der Testnachricht im Reiter Einstellungen. Änderungen werden automatisch gespeichert." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
