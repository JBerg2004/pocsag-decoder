<Window x:Class="PocsagDecoder.App.RicPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RICs für die Regel auswählen" Width="560" Height="600" MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Haken bei den RICs setzen, auf die die Regel reagieren soll. Mit der Suche z.B. „FF“ eingeben und dann „Alle sichtbaren anhaken“." />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock Text="Suchen:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <Button DockPanel.Dock="Right" Content="Sichtbare abhaken" Click="NoneVisible_Click" Margin="6,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Alle sichtbaren anhaken" Click="AllVisible_Click" Margin="6,0,0,0" />
            <TextBox x:Name="SearchBox" TextChanged="Search_TextChanged" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Übernehmen" IsDefault="True" Click="Ok_Click" FontWeight="SemiBold" />
                <Button Content="Abbrechen" IsCancel="True" Margin="6,0,0,0" />
            </StackPanel>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="#555" />
        </DockPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#EEE">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                      Click="Check_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="RIC" Binding="{Binding RicText}" Width="80" FontFamily="Consolas" IsReadOnly="True" />
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                <DataGridTextColumn Header="Kurz" Binding="{Binding ShortName}" Width="0.6*" IsReadOnly="True" />
                <DataGridTextColumn Header="Ort" Binding="{Binding Location}" Width="0.6*" IsReadOnly="True" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
