<Window x:Class="PocsagDecoder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PocsagDecoder.App.ViewModels"
        xmlns:conv="clr-namespace:PocsagDecoder.App.Converters"
        Title="POCSAG Decoder" Height="760" Width="1200" MinHeight="500" MinWidth="900"
        Icon="app.ico">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:FlexibleDoubleConverter x:Key="Double" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:InverseBoolConverter x:Key="Not" />
        <conv:TargetCheckedConverter x:Key="TargetChecked" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Kopfzeile -->
        <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="▶ Start" Command="{Binding StartCommand}" FontWeight="SemiBold" />
                    <Button Content="■ Stopp" Command="{Binding StopCommand}" />
                    <TextBlock Text="Frequenz (MHz):" VerticalAlignment="Center" Margin="12,0,4,0" />
                    <TextBox Width="90" Text="{Binding Decoder.FrequencyMHz, Converter={StaticResource Double}, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />
                    <Button Content="💾 Speichern" Command="{Binding SaveCommand}" Margin="12,0,6,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#BBB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="#2DA44E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" />
                    <TextBlock Margin="16,0,0,0" Foreground="#555">
                        <Run Text="Empfangen:" /> <Run Text="{Binding ReceivedCount, Mode=OneWay}" />
                        <Run Text="  Weitergeleitet:" /> <Run Text="{Binding ForwardedCount, Mode=OneWay}" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Margin="6">
            <!-- ============================ EMPFANG ============================ -->
            <TabItem Header="Empfang">
                <DockPanel Margin="6">
                    <!-- Anzeige-Filter -->
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Filter  RIC:" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <TextBox Width="140" Text="{Binding ViewRic, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Teil einer RIC, oder Muster wie 12345*, 1000000-1000999, 111,222" />
                        <TextBlock Text="SubRIC:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <ComboBox Width="70" ItemsSource="{Binding SubRicChoices}" SelectedItem="{Binding ViewSubRic}" />
                        <TextBlock Text="Text:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Width="220" Text="{Binding ViewText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Sucht im Nachrichtentext und in der Beschreibung" />
                        <CheckBox Content="nur Regeltreffer" IsChecked="{Binding ViewOnlyMatched}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <TextBlock VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555">
                            <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" angezeigt" />
                        </TextBlock>
                        <Button Content="Liste leeren" Command="{Binding ClearMessagesCommand}" Margin="16,0,6,0" />
                        <Button x:Name="ColumnsButton" Content="Spalten ▾" Click="ColumnsButton_Click"
                                ToolTip="Spalten ein- oder ausblenden (auch per Rechtsklick auf die Spaltenköpfe)" />
                    </WrapPanel>


                    <DataGrid x:Name="MessagesGrid" ItemsSource="{Binding MessagesView}" SelectedItem="{Binding SelectedMessage}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                              SelectionMode="Single" EnableRowVirtualization="True">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Matched}" Value="True">
                                        <Setter Property="Background" Value="#E6F4EA" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasError}" Value="True">
                                        <Setter Property="Background" Value="#FDECEA" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Regel aus dieser Nachricht erstellen" Command="{Binding RuleFromMessageCommand}" />
                                <MenuItem Header="Beschreibung für diese RIC bearbeiten" Command="{Binding DescriptionFromMessageCommand}" />
                                <MenuItem Header="Zeile kopieren" Click="CopyMessage_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat='dd.MM. HH:mm:ss'}" Width="110" />
                            <DataGridTextColumn Header="RIC" Binding="{Binding Ric}" Width="80" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="SubRIC" Binding="{Binding SubRic}" Width="55" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding RicDescription}" Width="170">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="#1A4D8F" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ort" Binding="{Binding RicLocation}" Width="110" />
                            <DataGridTextColumn Header="Bezeichnung kurz" Binding="{Binding RicShortName}" Width="120">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Foreground" Value="#1A4D8F" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="SubRIC-Bedeutung" Binding="{Binding SubRicDescription}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="#8A3B00" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Fkt." Binding="{Binding Function}" Width="40" />
                            <DataGridTextColumn Header="Baud" Binding="{Binding Baud}" Width="50" />
                            <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="65" />
                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Weiterleitung" Binding="{Binding Forwarding}" Width="260">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Foreground" Value="#444" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ REGELN ============================ -->
            <TabItem x:Name="RulesTab" Header="Filterregeln">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Neue Regel" Command="{Binding AddRuleCommand}" />
                            <Button Content="Löschen" Command="{Binding RemoveRuleCommand}" />
                            <Button Content="▲" MinWidth="30" Command="{Binding MoveRuleUpCommand}" ToolTip="Nach oben" />
                            <Button Content="▼" MinWidth="30" Command="{Binding MoveRuleDownCommand}" ToolTip="Nach unten" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Wiederholungen derselben Nachricht nicht erneut senden innerhalb von" VerticalAlignment="Center" />
                            <TextBox Width="50" Margin="6,0" Text="{Binding DuplicateWindowSeconds}" />
                            <TextBlock Text="Sekunden (0 = aus)" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Die Regeln werden von oben nach unten geprüft. Jede passende Regel sendet an ihr Ziel. Mit „Danach stoppen“ werden die folgenden Regeln übersprungen. Tipp: Rechtsklick auf eine empfangene Nachricht → „Regel aus dieser Nachricht erstellen“." />
                        <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="RIC" Binding="{Binding RicPattern}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="SubRIC" Binding="{Binding SubRicSummary, Mode=OneWay}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Beschreibung" Binding="{Binding DescriptionText}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Ziele" Binding="{Binding TargetName}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedRule}" Margin="4,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Regel bearbeiten" FontSize="15" FontWeight="SemiBold" />
                            <CheckBox Content="Regel aktiv" IsChecked="{Binding Enabled}" Margin="0,8,0,0" />

                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="RIC" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Nach Bezeichnung auswählen…" Click="PickRics_Click" Margin="6,0,0,0"
                                        ToolTip="RICs aus der Liste der RIC-Beschreibungen per Haken auswählen" />
                                <TextBox Text="{Binding RicPattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Foreground="#1B5E20" FontStyle="Normal"
                                       Text="{Binding DataContext.RuleRicPreview, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Leer oder * = alle. Mehrere durch Komma: 1234567, 1000000-1000999, 12345* (Platzhalter * und ?)." />

                            <TextBlock Text="SubRIC" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{Binding DataContext.SubRicLabelA, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicA}" Margin="0,0,12,0" />
                                <CheckBox Content="{Binding DataContext.SubRicLabelB, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicB}" Margin="0,0,12,0" />
                                <CheckBox Content="{Binding DataContext.SubRicLabelC, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicC}" Margin="0,0,12,0" />
                                <CheckBox Content="{Binding DataContext.SubRicLabelD, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicD}" />
                            </StackPanel>

                            <TextBlock Text="Text" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.TextModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding TextMode}" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Leer = beliebiger Text. Contains / NotContains ignorieren Groß-/Kleinschreibung, Regex = regulärer Ausdruck." />

                            <TextBlock Text="Beschreibung (Bezeichnung der RIC / SubRIC-Bedeutung)" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.TextModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DescriptionMode}" />
                                <TextBox Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Prüft die Beschreibung aus dem Reiter „RIC-Beschreibungen“, z.B. „FF Musterstadt“ oder „Vollalarm“. Mehrere Begriffe mit | trennen: „FF Nord|FF Süd“. Leer = egal." />

                            <TextBlock Text="Weiterleiten an" Style="{StaticResource FieldLabel}" />
                            <Border BorderBrush="#DDD" BorderThickness="1" Padding="6,4">
                                <ItemsControl ItemsSource="{Binding DataContext.Targets, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" Tag="{Binding Name}" Margin="0,2" Click="RuleTarget_Click">
                                                <CheckBox.IsChecked>
                                                    <MultiBinding Converter="{StaticResource TargetChecked}" Mode="OneWay">
                                                        <Binding Path="Name" />
                                                        <Binding Path="DataContext.SelectedRule.TargetName" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </CheckBox.IsChecked>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="Mehrere Ziele anhaken = an alle gleichzeitig senden. Keins angehakt = Nachricht nur grün markieren, nicht senden." />

                            <CheckBox Content="Danach stoppen (folgende Regeln nicht prüfen)" IsChecked="{Binding StopProcessing}" Margin="0,10,0,0" />
                            <CheckBox Content="Wiederholungen trotzdem senden (Wiederholungs-Sperre gilt hier nicht)" IsChecked="{Binding SendRepeats}" Margin="0,6,0,0" />

                            <TextBlock Foreground="#C62828" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="{Binding DataContext.RuleError, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================ BESCHREIBUNGEN ============================ -->
            <TabItem x:Name="DescriptionsTab" Header="RIC-Beschreibungen">
                <DockPanel Margin="6">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="📂 Datei importieren…" Click="ImportDescriptions_Click" FontWeight="SemiBold" />
                        <Button Content="Exportieren…" Click="ExportDescriptions_Click" />
                        <Button Content="Vorlage speichern…" Click="SaveTemplate_Click" />
                        <Button Content="+ Neuer Eintrag" Command="{Binding AddDescriptionCommand}" Margin="12,0,6,0" />
                        <Button Content="Löschen" Command="{Binding RemoveDescriptionCommand}" />
                        <Button Content="Alle löschen" Command="{Binding ClearDescriptionsCommand}" />
                        <TextBlock Text="Suchen:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Width="200" Text="{Binding DescriptionSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="SubRICs zuordnen…" Click="GlobalSubRics_Click" Margin="8,0,6,0" FontWeight="SemiBold"
                                ToolTip="Bedeutung von SubRIC A, B, C, D für alle RICs festlegen" />
                        <TextBlock Text="{Binding DescriptionStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#555" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding GlobalSubRicSummary}" Margin="0,0,0,6" Foreground="#8A3B00" FontWeight="SemiBold" />
                    <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" Padding="8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Dateiformat für den Import (CSV/TXT, z.B. aus Excel, oder JSON)" />
                            <TextBlock Style="{StaticResource Hint}" FontFamily="Consolas" FontSize="12"
                                       Text="RIC;Bezeichnung;Kurz;Ort;A;B;C;D&#10;1234567;FF Musterstadt;Musterst.;Musterstadt;Vollalarm;Kleinalarm;Probealarm;Info&#10;1234568;FF Beispieldorf;Beispield.;Beispieldorf;Einsatz;Atemschutz;;Sirene" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Eine Zeile pro RIC, leere Felder sind erlaubt. Trennzeichen ; Tab , oder |. Die Spalten werden anhand der Kopfzeile erkannt (A–D bzw. 1–4), die Reihenfolge ist egal. Ältere Dateien mit einer Zeile pro SubRIC (RIC;SubRIC;Beschreibung) werden ebenfalls gelesen. Die Spalten A–D hier sind nur nötig, wenn eine RIC von der allgemeinen SubRIC-Zuordnung abweicht – sonst leer lassen. Doppelklick auf ein Feld zum Bearbeiten. Spalte „Kurz“ (oder „Bezeichnung kurz“) = kurze Bezeichnung, Spalte „Ort“ = Ort. In Webhooks: {description}, {ric_description}, {ric_short}, {ric_location}, {subric_description}." />
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding DescriptionsView}" SelectedItem="{Binding SelectedDescription}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All"
                              HorizontalGridLinesBrush="#EEE" VerticalGridLinesBrush="#EEE">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RIC" Binding="{Binding Ric, StringFormat=D7}" Width="80" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Bezeichnung (RIC)" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.3*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Bezeichnung kurz" Binding="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Ort" Binding="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="A (nur diese RIC)" Binding="{Binding A, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="B (nur diese RIC)" Binding="{Binding B, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="C (nur diese RIC)" Binding="{Binding C, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="D (nur diese RIC)" Binding="{Binding D, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ ZIELE ============================ -->
            <TabItem Header="Weiterleitung (REST / Webhook)">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Neues Ziel" Command="{Binding AddTargetCommand}" />
                            <Button Content="Löschen" Command="{Binding RemoveTargetCommand}" />
                        </StackPanel>
                        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="1" Background="#FAFAFA" Padding="8" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="SubRIC-Buchstaben" FontWeight="SemiBold" />
                                <RadioButton Content="groß (A, B, C, D)" Margin="0,4,0,0"
                                             IsChecked="{Binding LowercaseSubRic, Converter={StaticResource Not}}" />
                                <RadioButton Content="klein (a, b, c, d)" Margin="0,2,0,0" IsChecked="{Binding LowercaseSubRic}" />
                                <TextBlock Style="{StaticResource Hint}" Text="Gilt für die Anzeige im Empfang und für {subric} beim Senden. Fest: {subric_upper} / {subric_lower}." />
                            </StackPanel>
                        </Border>
                        <ListBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox IsChecked="{Binding Enabled}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedTarget}" Margin="0,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Ziel bearbeiten" FontSize="15" FontWeight="SemiBold" />
                            <CheckBox Content="Ziel aktiv" IsChecked="{Binding Enabled}" Margin="0,8,0,0" />

                            <TextBlock Text="Name (wird in den Regeln ausgewählt)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Methode und URL" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Width="80" Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.HttpMethods, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Method}" />
                                <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Platzhalter sind auch in der URL erlaubt, z.B. https://server/api/alarm?ric={ric}&amp;sub={subric}&amp;text={message} (werden URL-kodiert)." />

                            <TextBlock Text="Content-Type" Style="{StaticResource FieldLabel}" />
                            <ComboBox IsEditable="True" Text="{Binding ContentType, UpdateSourceTrigger=PropertyChanged}"
                                      ItemsSource="{Binding DataContext.ContentTypes, RelativeSource={RelativeSource AncestorType=Window}}" />

                            <TextBlock Text="Zusätzliche Header (eine Zeile je Header, „Name: Wert“)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Headers, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top" />
                            <TextBlock Style="{StaticResource Hint}" Text="z.B. Authorization: Bearer DEIN_TOKEN" />

                            <TextBlock Text="Body-Vorlage (bei GET ohne Bedeutung)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding BodyTemplate, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                     Height="190" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" VerticalContentAlignment="Top" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Bei JSON werden die Werte automatisch JSON-sicher eingesetzt (Anführungszeichen, Zeilenumbrüche)." />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Timeout (s)" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBox Width="45" Text="{Binding TimeoutSeconds}" />
                                <TextBlock Text="Wiederholungen bei Fehler" VerticalAlignment="Center" Margin="14,0,4,0" />
                                <TextBox Width="45" Text="{Binding Retries}" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="Testnachricht senden"
                                        Command="{Binding DataContext.TestTargetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"
                                           Text="{Binding DataContext.TargetTestResult, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="Verwendet RIC, SubRIC und Text aus dem Reiter Test." />
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Column="4">
                        <TextBlock DockPanel.Dock="Top" Text="Platzhalter" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ListView ItemsSource="{Binding Placeholders}" MouseDoubleClick="Placeholder_DoubleClick"
                                  ToolTip="Doppelklick kopiert den Platzhalter in die Zwischenablage">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Platzhalter" DisplayMemberBinding="{Binding Key}" Width="95" />
                                    <GridViewColumn Header="Bedeutung" DisplayMemberBinding="{Binding Value}" Width="150" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================ EMPFÄNGER ============================ -->
            <TabItem Header="Empfänger (SDR)">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" MaxWidth="760" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}">
                        <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,6"
                                   Text="Änderungen werden beim nächsten Start übernommen. Der Decoder muss dafür gestoppt sein." />

                        <TextBlock Text="Quelle" Style="{StaticResource FieldLabel}" />
                        <RadioButton Content="RTL-SDR-Stick (rtl__fm → multimon-ng)" GroupName="mode"
                                     IsChecked="{Binding Decoder.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=RtlSdr}" />
                        <RadioButton Content="Eigener Befehl (Ausgabe im multimon-ng-Format)" GroupName="mode" Margin="0,4,0,0"
                                     IsChecked="{Binding Decoder.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=CustomCommand}" />

                        <TextBlock Text="Pfad zu rtl_fm.exe" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Margin="6,0,0,0" Click="BrowseRtlFm_Click" />
                            <TextBox Text="{Binding Decoder.RtlFmPath}" />
                        </DockPanel>

                        <TextBlock Text="Pfad zu multimon-ng.exe" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Margin="6,0,0,0" Click="BrowseMultimon_Click" />
                            <TextBox Text="{Binding Decoder.MultimonPath}" />
                        </DockPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Frequenz (MHz)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Decoder.FrequencyMHz, Converter={StaticResource Double}}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gain (dB)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Decoder.GainDb, Converter={StaticResource Double}, TargetNullValue=''}"
                                         ToolTip="Leer = automatische Verstärkung" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Korrektur (ppm)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Decoder.Ppm}" />
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Squelch" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Decoder.Squelch}" ToolTip="0 = aus (empfohlen für POCSAG)" />
                            </StackPanel>
                            <StackPanel Grid.Column="8">
                                <TextBlock Text="Stick-Nr." Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Decoder.DeviceIndex}" ToolTip="0 = erster Stick" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Gain leer lassen für automatische Verstärkung. Die ppm-Korrektur des Sticks lässt sich z.B. mit rtl_test -p oder kalibrate ermitteln." />

                        <TextBlock Text="Baudraten" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="POCSAG 512" IsChecked="{Binding Decoder.Pocsag512}" Margin="0,0,14,0" />
                            <CheckBox Content="POCSAG 1200" IsChecked="{Binding Decoder.Pocsag1200}" Margin="0,0,14,0" />
                            <CheckBox Content="POCSAG 2400" IsChecked="{Binding Decoder.Pocsag2400}" />
                        </StackPanel>

                        <TextBlock Text="Dekodierung (multimon-ng -f)" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="150" HorizontalAlignment="Left" IsEditable="False"
                                  ItemsSource="{Binding DecodeModes}" SelectedItem="{Binding Decoder.DecodeMode}" />
                        <TextBlock Style="{StaticResource Hint}" Text="alpha ist für BOS/Feuerwehr üblich. auto lässt multimon-ng zwischen Text und Ziffern wählen." />

                        <TextBlock Text="Fehlerkorrektur (multimon-ng -b)" Style="{StaticResource FieldLabel}" />
                        <ComboBox Width="150" HorizontalAlignment="Left" ItemsSource="{Binding ErrorCorrectionLevels}" SelectedItem="{Binding Decoder.ErrorCorrection}" />
                        <TextBlock Style="{StaticResource Hint}" Text="Wie viele Bitfehler pro Codewort repariert werden. 2 holt bei schlechtem Empfang mehr heraus, erzeugt aber gelegentlich falsche RICs (Phantom-Tonrufe). 1 = empfohlen, 0 = nur fehlerfreie Meldungen." />
                        <CheckBox Content="Unwahrscheinliche Meldungen aussortieren (multimon-ng -u)" IsChecked="{Binding Decoder.HeuristicPruning}" Margin="0,6,0,0" />

                        <TextBlock Text="Zusätzliche Parameter rtl_fm" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Decoder.RtlFmExtraArgs}" FontFamily="Consolas" />
                        <TextBlock Text="Zusätzliche Parameter multimon-ng" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Decoder.MultimonExtraArgs}" FontFamily="Consolas" />

                        <TextBlock Text="Eigener Befehl (wird mit cmd.exe /c ausgeführt)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Decoder.CustomCommand}" FontFamily="Consolas" TextWrapping="Wrap" Height="50" VerticalContentAlignment="Top" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Nur für die Quelle „Eigener Befehl“, z.B. multimon-ng mit Audioeingang einer anderen SDR-Software (virtuelles Audiokabel)." />

                        <TextBlock Text="Sonstiges" Style="{StaticResource FieldLabel}" />
                        <CheckBox Content="Deutsche Umlaute umwandeln ( [ \ ] { | } ~  →  Ä Ö Ü ä ö ü ß )" IsChecked="{Binding Decoder.GermanUmlauts}" />
                        <CheckBox Content="Empfangene Nachrichten als CSV-Tagesdatei speichern" IsChecked="{Binding Settings.LogToCsv}" Margin="0,4,0,0" />
                        <CheckBox Content="Decoder beim Programmstart automatisch starten" IsChecked="{Binding Settings.AutoStart}" Margin="0,4,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="CSV-Ordner öffnen" Command="{Binding OpenLogFolderCommand}" />
                            <Button Content="💾 Einstellungen speichern" Command="{Binding SaveCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ TEST ============================ -->
            <TabItem Header="Test">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" MaxWidth="700" HorizontalAlignment="Left">
                        <TextBlock Text="Testnachricht einspeisen" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                   Text="Erzeugt eine Nachricht wie vom Funk, ohne SDR-Stick. Sie erscheint im Reiter Empfang und durchläuft Beschreibungen, Filterregeln und Weiterleitung genau wie eine echte Meldung." />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="RIC" VerticalAlignment="Center" FontWeight="SemiBold" />
                            <TextBox Grid.Column="1" Width="120" HorizontalAlignment="Left" FontFamily="Consolas"
                                     Text="{Binding SimRic, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Row="1" Text="SubRIC" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,8,0,0"
                                      ItemsSource="{Binding SimSubRicChoices}" SelectedItem="{Binding SimSubRic}" />
                            <TextBlock Grid.Row="2" Text="Beschreibung" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SimDescription}" Foreground="#1A4D8F" Margin="0,8,0,0" />
                            <TextBlock Grid.Row="3" Text="Text" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Height="60" TextWrapping="Wrap" AcceptsReturn="False"
                                     VerticalContentAlignment="Top" Text="{Binding SimText, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="110,10,0,0">
                            <Button Content="Einspeisen" Command="{Binding SimulateCommand}" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                       Text="Text leer lassen = reiner Ton-Alarm." />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,16,0,0"
                                   Text="Dieselben Werte nutzt auch „Testnachricht senden“ im Reiter Weiterleitung." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ PROTOKOLL ============================ -->
            <TabItem Header="Protokoll">
                <DockPanel Margin="6">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Leeren" Command="{Binding ClearLogCommand}" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Text="Ausgaben von rtl_fm / multimon-ng, Start/Stopp und Ergebnisse der Weiterleitung." />
                    </StackPanel>
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
