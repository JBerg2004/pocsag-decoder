<Window x:Class="PocsagDecoder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PocsagDecoder.App.ViewModels"
        xmlns:local="clr-namespace:PocsagDecoder.App"
        xmlns:conv="clr-namespace:PocsagDecoder.App.Converters"
        Title="POCSAG Decoder" Height="760" Width="1200" MinHeight="500" MinWidth="900"
        Icon="app.ico" Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="12.5"
        TextOptions.TextFormattingMode="Display">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:FlexibleDoubleConverter x:Key="Double" />
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:InverseBoolConverter x:Key="Not" />
        <conv:TargetCheckedConverter x:Key="TargetChecked" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>
        <!-- Kopfzeile -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="14,9">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Image Source="app.ico" Width="22" Height="22" Margin="0,0,8,0" />
                    <TextBlock Text="POCSAG Decoder" Foreground="White" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,22,0" />
                    <Button Content="▶  Start" Command="{Binding StartCommand}" Style="{StaticResource GoButton}" />
                    <Button Content="■  Stopp" Command="{Binding StopCommand}" Style="{StaticResource HeaderButton}" />
                    <TextBlock Text="Frequenz" Foreground="{DynamicResource HeaderMutedBrush}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="80" Text="{Binding Decoder.FrequencyMHz, Converter={StaticResource Double}, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}" />
                    <TextBlock Text="MHz" Foreground="{DynamicResource HeaderMutedBrush}" VerticalAlignment="Center" Margin="6,0,16,0" />
                    <Button Content="💾  Speichern" Command="{Binding SaveCommand}" Style="{StaticResource HeaderButton}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border CornerRadius="11" Padding="10,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource HeaderButtonLineBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Background" Value="#2E7D32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="White" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" Foreground="White" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Statusleiste unten -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Clock}" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{Binding UpdateText}" Command="{Binding OpenUpdateCommand}"
                        FontWeight="SemiBold" Margin="0,0,14,0" Padding="4,0" MinHeight="0"
                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" ToolTip="{Binding UpdateToolTip}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource IdleBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource LineBrush}" Margin="12,0" />
                    <TextBlock Text="{Binding LastReceivedText}" VerticalAlignment="Center" />
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource LineBrush}" Margin="12,0" />
                    <!-- Empfangsqualität: drei Balken -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding QualityToolTip}" Background="Transparent">
                        <StackPanel.Resources>
                            <Style x:Key="QualityBar" TargetType="Rectangle">
                                <Setter Property="Width" Value="4" />
                                <Setter Property="Margin" Value="0,0,2,0" />
                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                <Setter Property="Fill" Value="{DynamicResource IdleBrush}" />
                            </Style>
                        </StackPanel.Resources>
                        <Rectangle Height="5">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle" BasedOn="{StaticResource QualityBar}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QualityLevel}" Value="1"><Setter Property="Fill" Value="{DynamicResource FailBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding QualityLevel}" Value="2"><Setter Property="Fill" Value="{DynamicResource SubRicBBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding QualityLevel}" Value="3"><Setter Property="Fill" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <Rectangle Height="9">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle" BasedOn="{StaticResource QualityBar}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QualityLevel}" Value="2"><Setter Property="Fill" Value="{DynamicResource SubRicBBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding QualityLevel}" Value="3"><Setter Property="Fill" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <Rectangle Height="13">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle" BasedOn="{StaticResource QualityBar}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QualityLevel}" Value="3"><Setter Property="Fill" Value="{DynamicResource OkBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <TextBlock Text="{Binding QualityText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <!-- Master/Slave -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding RedundancyToolTip}" Background="Transparent">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RedundancyLevel}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Rectangle Width="1" Height="14" Fill="{DynamicResource LineBrush}" Margin="12,0" />
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RedundancyLevel}" Value="2"><Setter Property="Fill" Value="{DynamicResource SubRicBBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding RedundancyLevel}" Value="3"><Setter Property="Fill" Value="{DynamicResource FailBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding RedundancyBarText}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RedundancyLevel}" Value="3"><Setter Property="FontWeight" Value="Bold" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource LineBrush}" Margin="12,0" />
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Empfangen" Foreground="{DynamicResource MutedBrush}" /> <Run Text="{Binding ReceivedCount, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="   Weitergeleitet" Foreground="{DynamicResource MutedBrush}" /> <Run Text="{Binding ForwardedCount, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs">
            <!-- ============================ EMPFANG ============================ -->
            <TabItem Header="Telegramme">
                <DockPanel Margin="12,10">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <Button Content="Liste leeren" Command="{Binding ClearMessagesCommand}"
                                ToolTip="Alle empfangenen Meldungen aus allen Fenstern entfernen" />
                        <Button x:Name="PaneMenuButton" Content="Fenster ▾" Click="PaneMenu_Click"
                                ToolTip="Fenster hinzufügen, anordnen, konfigurieren, verschieben oder löschen" />
                    </WrapPanel>
                    <ItemsControl ItemsSource="{Binding Panes}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding DataContext.PaneColumns, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:MessagePaneView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>

            <!-- ============================ VERLAUF ============================ -->
            <TabItem Header="Verlauf">
                <DockPanel Margin="12,10">
                    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Von" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Width="90" Text="{Binding HistoryFrom, UpdateSourceTrigger=PropertyChanged}" ToolTip="TT.MM.JJJJ" />
                                <TextBlock Text="bis" VerticalAlignment="Center" Margin="8,0,6,0" />
                                <TextBox Width="90" Text="{Binding HistoryTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="TT.MM.JJJJ" Margin="0,0,10,0" />
                                <Button Content="Heute" Command="{Binding HistoryRangeCommand}" CommandParameter="0" MinWidth="0" />
                                <Button Content="7 Tage" Command="{Binding HistoryRangeCommand}" CommandParameter="7" MinWidth="0" />
                                <Button Content="30 Tage" Command="{Binding HistoryRangeCommand}" CommandParameter="30" MinWidth="0" />
                                <Button Content="Alles" Command="{Binding HistoryRangeCommand}" CommandParameter="-1" MinWidth="0" Margin="0,0,14,0" />
                                <TextBlock Text="SubRIC" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox Width="65" ItemsSource="{Binding HistorySubRicChoices}" SelectedItem="{Binding HistorySubRic}" Margin="0,0,14,0" />
                                <CheckBox Content="nur weitergeleitete" IsChecked="{Binding HistoryOnlyForwarded}" VerticalAlignment="Center" />
                            </WrapPanel>
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="📊 Als Excel speichern…" Click="ExportHistory_Click" Margin="6,0,0,0" />
                                <Button DockPanel.Dock="Right" Content="🔍 Suchen" Command="{Binding SearchHistoryCommand}" Style="{StaticResource PrimaryButton}" IsDefault="False" Margin="6,0,0,0" />
                                <TextBlock DockPanel.Dock="Left" Text="Suche" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="HistorySearchBox" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" KeyDown="HistorySearch_KeyDown"
                                         ToolTip="Mehrere Begriffe mit Leerzeichen: alle müssen vorkommen, z. B. „Kesten Einsatz“" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Sucht in den gespeicherten CSV-Tagesdateien (Einstellungen → Aufzeichnung) nach RIC, Bezeichnung, Ort, Kurzbezeichnung, SubRIC-Bedeutung, Text und Weiterleitung. Bezeichnungen kommen aus der aktuellen RIC-Liste. Enter startet die Suche." />
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryStatus}" Margin="2,0,0,6" Foreground="{DynamicResource SecondaryTextBrush}" />
                    <DataGrid ItemsSource="{Binding HistoryResults}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Extended" EnableRowVirtualization="True" FontSize="{Binding ListFontSize}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="BorderThickness" Value="0" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.SubRicColors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            <Condition Binding="{Binding Function}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SubRicABrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.SubRicColors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            <Condition Binding="{Binding Function}" Value="1" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SubRicBBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.SubRicColors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            <Condition Binding="{Binding Function}" Value="2" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SubRicCBrush}" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.SubRicColors, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                            <Condition Binding="{Binding Function}" Value="3" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource SubRicDBrush}" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="135" />
                            <DataGridTextColumn Header="RIC" Binding="{Binding Ric}" Width="80" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTemplateColumn Header="SubRIC" Width="55" SortMemberPath="SubRic">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource SubRicBadge}">
                                            <TextBlock Text="{Binding SubRic}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Bezeichnung" Binding="{Binding RicDescription}" Width="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Foreground" Value="{DynamicResource InfoTextBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Ort" Binding="{Binding RicLocation}" Width="120" />
                            <DataGridTextColumn Header="SubRIC-Bedeutung" Binding="{Binding SubRicDescription}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource SubRicTextBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Weiterleitung" Binding="{Binding Forwarding}" Width="240">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ REGELN ============================ -->
            <TabItem x:Name="RulesTab" Header="Telegrammereignisse">
                <Grid Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="2*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button Content="+ Neues Ereignis" Command="{Binding AddRuleCommand}" />
                            <Button Content="Löschen" Command="{Binding RemoveRuleCommand}" />
                            <Button Content="▲" MinWidth="30" Command="{Binding MoveRuleUpCommand}" ToolTip="Nach oben" />
                            <Button Content="▼" MinWidth="30" Command="{Binding MoveRuleDownCommand}" ToolTip="Nach unten" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Wiederholungen derselben Nachricht nicht erneut senden innerhalb von" VerticalAlignment="Center" />
                            <TextBox Width="50" Margin="6,0" Text="{Binding DuplicateWindowSeconds}" />
                            <TextBlock Text="Sekunden (0 = aus)" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Hint}" Margin="0,6,0,0"
                                   Text="Die Telegrammereignisse werden von oben nach unten geprüft. Jedes passende Ereignis wird an seine Schnittstellen gesendet. Mit „Danach stoppen“ werden die folgenden Ereignisse übersprungen. Tipp: Rechtsklick auf eine empfangene Nachricht → „Telegrammereignis aus dieser Nachricht erstellen“." />
                        <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="45" />
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="RIC" Binding="{Binding RicPattern}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="SubRIC" Binding="{Binding SubRicSummary, Mode=OneWay}" Width="60" IsReadOnly="True" />
                                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Beschreibung" Binding="{Binding DescriptionText}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Ziele" Binding="{Binding TargetName}" Width="*" IsReadOnly="True" />
                                <DataGridCheckBoxColumn Header="Hinweis" Binding="{Binding TrayNotify, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding SelectedRule}" Margin="4,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <Trigger Property="DataContext" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Telegrammereignis bearbeiten" FontSize="15" FontWeight="SemiBold" />
                            <CheckBox Content="Ereignis aktiv" IsChecked="{Binding Enabled}" Margin="0,8,0,0" />

                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="RIC" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Nach Bezeichnung auswählen…" Click="PickRics_Click" Margin="6,0,0,0"
                                        ToolTip="RICs aus der Liste der RIC-Beschreibungen per Haken auswählen" />
                                <TextBox Text="{Binding RicPattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Foreground="{DynamicResource GoTextBrush}" FontStyle="Normal"
                                       Text="{Binding DataContext.RuleRicPreview, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Leer oder * = alle. Mehrere durch Komma: 1234567, 1000000-1000999, 12345* (Platzhalter * und ?)." />

                            <TextBlock Text="SubRIC" Style="{StaticResource FieldLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="{Binding DataContext.SubRicLabelA, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicA}" Margin="0,0,12,0" />
                                <CheckBox Content="{Binding DataContext.SubRicLabelB, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicB}" Margin="0,0,12,0" />
                                <CheckBox Content="{Binding DataContext.SubRicLabelC, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicC}" Margin="0,0,12,0" />
                                <CheckBox Content="{Binding DataContext.SubRicLabelD, RelativeSource={RelativeSource AncestorType=Window}}" IsChecked="{Binding SubRicD}" />
                            </StackPanel>

                            <TextBlock Text="Text" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.TextModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding TextMode}" />
                                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Leer = beliebiger Text. Contains / NotContains ignorieren Groß-/Kleinschreibung, Regex = regulärer Ausdruck." />

                            <TextBlock Text="Beschreibung (Bezeichnung der RIC / SubRIC-Bedeutung)" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <ComboBox DockPanel.Dock="Left" Width="110" Margin="0,0,6,0"
                                          ItemsSource="{Binding DataContext.TextModes, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding DescriptionMode}" />
                                <TextBox Text="{Binding DescriptionText, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Prüft die Beschreibung aus dem Reiter „RIC-Beschreibungen“, z.B. „FF Musterstadt“ oder „Vollalarm“. Mehrere Begriffe mit | trennen: „FF Nord|FF Süd“. Leer = egal." />

                            <TextBlock Text="Weiterleiten an" Style="{StaticResource FieldLabel}" />
                            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}" CornerRadius="4" Padding="6,4">
                                <ItemsControl ItemsSource="{Binding DataContext.Targets, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" Tag="{Binding Name}" Margin="0,2" Click="RuleTarget_Click">
                                                <CheckBox.IsChecked>
                                                    <MultiBinding Converter="{StaticResource TargetChecked}" Mode="OneWay">
                                                        <Binding Path="Name" />
                                                        <Binding Path="DataContext.SelectedRule.TargetName" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </CheckBox.IsChecked>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="Mehrere Ziele anhaken = an alle gleichzeitig senden. Keins angehakt = Nachricht nur grün markieren, nicht senden." />

                            <CheckBox Content="Danach stoppen (folgende Ereignisse nicht prüfen)" IsChecked="{Binding StopProcessing}" Margin="0,10,0,0" />
                            <CheckBox Content="Wiederholungen trotzdem senden (Wiederholungs-Sperre gilt hier nicht)" IsChecked="{Binding SendRepeats}" Margin="0,6,0,0" />
                            <CheckBox Content="Hinweis unten rechts anzeigen" IsChecked="{Binding TrayNotify}" Margin="0,6,0,0"
                                      ToolTip="Gilt nur, wenn in den Einstellungen „Hinweis unten rechts bei Telegrammereignissen“ eingeschaltet ist und das Fenster ausgeblendet ist." />

                            <TextBlock Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0"
                                       Text="{Binding DataContext.RuleError, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ============================ BESCHREIBUNGEN ============================ -->
            <TabItem x:Name="DescriptionsTab" Header="RIC-Beschreibungen">
                <DockPanel Margin="12,10">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Content="📂 Datei importieren…" Click="ImportDescriptions_Click" FontWeight="SemiBold" />
                        <Button Content="Exportieren…" Click="ExportDescriptions_Click" />
                        <Button Content="Vorlage speichern…" Click="SaveTemplate_Click" />
                        <Button Content="+ Neuer Eintrag" Command="{Binding AddDescriptionCommand}" Margin="12,0,6,0" />
                        <Button Content="Löschen" Command="{Binding RemoveDescriptionCommand}" />
                        <Button Content="Alle löschen" Command="{Binding ClearDescriptionsCommand}" />
                        <TextBlock Text="Suchen:" VerticalAlignment="Center" Margin="12,0,4,0" />
                        <TextBox Width="200" Text="{Binding DescriptionSearch, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="SubRICs zuordnen…" Click="GlobalSubRics_Click" Margin="8,0,6,0" FontWeight="SemiBold"
                                ToolTip="Bedeutung von SubRIC A, B, C, D für alle RICs festlegen" />
                        <TextBlock Text="{Binding DescriptionStatus}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}" />
                    </WrapPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding GlobalSubRicSummary}" Margin="0,0,0,6" Foreground="{DynamicResource SubRicTextBrush}" FontWeight="SemiBold" />
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="8" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Dateiformat für den Import (CSV/TXT, z.B. aus Excel, oder JSON)" />
                            <TextBlock Style="{StaticResource Hint}" FontFamily="Consolas" FontSize="12"
                                       Text="RIC;Bezeichnung;Kurz;Ort;A;B;C;D&#10;1234567;FF Musterstadt;Musterst.;Musterstadt;Vollalarm;Kleinalarm;Probealarm;Info&#10;1234568;FF Beispieldorf;Beispield.;Beispieldorf;Einsatz;Atemschutz;;Sirene" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Eine Zeile pro RIC, leere Felder sind erlaubt. Trennzeichen ; Tab , oder |. Die Spalten werden anhand der Kopfzeile erkannt (A–D bzw. 1–4), die Reihenfolge ist egal. Ältere Dateien mit einer Zeile pro SubRIC (RIC;SubRIC;Beschreibung) werden ebenfalls gelesen. Die Spalten A–D hier sind nur nötig, wenn eine RIC von der allgemeinen SubRIC-Zuordnung abweicht – sonst leer lassen. Doppelklick auf ein Feld zum Bearbeiten. Spalte „Kurz“ (oder „Bezeichnung kurz“) = kurze Bezeichnung, Spalte „Ort“ = Ort. In Webhooks: {description}, {ric_description}, {ric_short}, {ric_location}, {subric_description}, {bosmon_user}. Spalte „BosMon-Benutzer“ = Benutzer des BosMon-Netzwerkereignisses; eine BosMon-Konfiguration (.ini mit den Ereignissen) kann direkt importiert werden und füllt diese Spalte." />
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding DescriptionsView}" SelectedItem="{Binding SelectedDescription}"
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="All"
                             >
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="RIC" Binding="{Binding Ric, StringFormat=D7}" Width="80" FontFamily="Consolas" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Bezeichnung (RIC)" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="1.3*" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Bezeichnung kurz" Binding="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Ort" Binding="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="BosMon-Benutzer" Binding="{Binding BosMonUser, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="A (nur diese RIC)" Binding="{Binding A, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="B (nur diese RIC)" Binding="{Binding B, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="C (nur diese RIC)" Binding="{Binding C, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="D (nur diese RIC)" Binding="{Binding D, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================ ZIELE ============================ -->
            <TabItem Header="Schnittstellen">
                <local:TargetsView />
            </TabItem>

            <!-- ============================ EINSTELLUNGEN ============================ -->
            <TabItem Header="Einstellungen">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="12,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="💾 Einstellungen speichern" Command="{Binding SaveCommand}" Margin="0" />
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0"
                                       Text="Design, Farben und Schriftgröße werden sofort übernommen und automatisch gespeichert." />
                        </DockPanel>
                    </Border>
                <TabControl Style="{StaticResource SideTabs}">
                    <TabItem Header="📡  Empfang">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14" MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="Empfang" Style="{StaticResource SectionTitle}" />
                                <Border Background="{DynamicResource WarnBoxBrush}" BorderBrush="{DynamicResource WarnLineBrush}" BorderThickness="1" Padding="8,5" Margin="0,0,0,10"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                    <TextBlock TextWrapping="Wrap"
                                               Text="Der Empfang läuft. Die Empfangseinstellungen links lassen sich erst nach „■ Stopp“ ändern. Alles rechts geht jederzeit." />
                                </Border>
                                <StackPanel IsEnabled="{Binding IsRunning, Converter={StaticResource Not}}">
                                    <GroupBox Header="Empfangsquelle">
                                        <StackPanel>
                                            <RadioButton Content="RTL-SDR-Stick (rtl__fm → multimon-ng)" GroupName="mode"
                                                         IsChecked="{Binding Decoder.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=RtlSdr}" />
                                            <RadioButton Content="Eigener Befehl (Ausgabe im multimon-ng-Format)" GroupName="mode" Margin="0,4,0,0"
                                                         IsChecked="{Binding Decoder.Mode, Converter={StaticResource EnumEquals}, ConverterParameter=CustomCommand}" />

                                            <TextBlock Text="Pfad zu rtl_fm.exe" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Margin="6,0,0,0" Click="BrowseRtlFm_Click" />
                                                <TextBox Text="{Binding Decoder.RtlFmPath}" />
                                            </DockPanel>
                                            <TextBlock Text="Pfad zu multimon-ng.exe" Style="{StaticResource FieldLabel}" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Margin="6,0,0,0" Click="BrowseMultimon_Click" />
                                                <TextBox Text="{Binding Decoder.MultimonPath}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="SDR-Stick">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="10" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Frequenz (MHz)" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding Decoder.FrequencyMHz, Converter={StaticResource Double}}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Gain (dB)" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding Decoder.GainDb, Converter={StaticResource Double}, TargetNullValue=''}"
                                                             ToolTip="Leer = automatische Verstärkung" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="4">
                                                    <TextBlock Text="Korrektur (ppm)" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding Decoder.Ppm}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="6">
                                                    <TextBlock Text="Squelch" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding Decoder.Squelch}" ToolTip="0 = aus (empfohlen für POCSAG)" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="8">
                                                    <TextBlock Text="Stick-Nr." Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                                    <TextBox Text="{Binding Decoder.DeviceIndex}" ToolTip="0 = erster Stick" />
                                                </StackPanel>
                                            </Grid>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Gain leer lassen für automatische Verstärkung. Die ppm-Korrektur des Sticks lässt sich z.B. mit rtl_test -p oder kalibrate ermitteln." />
                                        </StackPanel>
                                    </GroupBox>

                                    <GroupBox Header="Decodierung (multimon-ng)">
                                        <StackPanel>
                                            <TextBlock Text="Baudraten" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                            <StackPanel Orientation="Horizontal">
                                                <CheckBox Content="POCSAG 512" IsChecked="{Binding Decoder.Pocsag512}" Margin="0,0,14,0" />
                                                <CheckBox Content="POCSAG 1200" IsChecked="{Binding Decoder.Pocsag1200}" Margin="0,0,14,0" />
                                                <CheckBox Content="POCSAG 2400" IsChecked="{Binding Decoder.Pocsag2400}" />
                                            </StackPanel>
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Dekodierung (-f)" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding DecodeModes}" SelectedItem="{Binding Decoder.DecodeMode}" />
                                                    <TextBlock Style="{StaticResource Hint}" Text="alpha ist für BOS/Feuerwehr üblich." />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Fehlerkorrektur (-b)" Style="{StaticResource FieldLabel}" />
                                                    <ComboBox ItemsSource="{Binding ErrorCorrectionLevels}" SelectedItem="{Binding Decoder.ErrorCorrection}" />
                                                    <TextBlock Style="{StaticResource Hint}" Text="1 = empfohlen. 2 holt mehr heraus, erzeugt aber gelegentlich falsche RICs. 0 = nur fehlerfreie." />
                                                </StackPanel>
                                            </Grid>
                                            <CheckBox Content="Unwahrscheinliche Meldungen aussortieren (-u)" IsChecked="{Binding Decoder.HeuristicPruning}" Margin="0,8,0,0" />
                                            <CheckBox Content="Deutsche Umlaute umwandeln ( [ \ ] { | } ~  →  Ä Ö Ü ä ö ü ß )" IsChecked="{Binding Decoder.GermanUmlauts}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </GroupBox>

                                    <Expander Header="Erweitert (zusätzliche Parameter, eigener Befehl)" Margin="0,0,0,10">
                                        <StackPanel Margin="4,4,0,0">
                                            <TextBlock Text="Zusätzliche Parameter rtl_fm" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Decoder.RtlFmExtraArgs}" FontFamily="Consolas" />
                                            <TextBlock Text="Zusätzliche Parameter multimon-ng" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Decoder.MultimonExtraArgs}" FontFamily="Consolas" />
                                            <TextBlock Text="Eigener Befehl (wird mit cmd.exe /c ausgeführt)" Style="{StaticResource FieldLabel}" />
                                            <TextBox Text="{Binding Decoder.CustomCommand}" FontFamily="Consolas" TextWrapping="Wrap" Height="50" VerticalContentAlignment="Top" />
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Nur für die Quelle „Eigener Befehl“, z.B. multimon-ng mit Audioeingang einer anderen SDR-Software (virtuelles Audiokabel)." />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="🖥  Programm">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14" MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="Programm und Hintergrund" Style="{StaticResource SectionTitle}" />
                                <GroupBox Header="Programmstart und Hintergrund">
                                    <StackPanel>
                                        <CheckBox Content="Empfang beim Programmstart automatisch starten" IsChecked="{Binding Settings.AutoStart}" />
                                        <CheckBox Content="Mit Windows starten (läuft dann im Hintergrund)" IsChecked="{Binding StartWithWindows}" Margin="0,4,0,0" />
                                        <CheckBox Content="Programm immer im Hintergrund starten" IsChecked="{Binding Settings.StartMinimized}" Margin="0,4,0,0" />
                                        <CheckBox Content="Beim Schließen (X) im Hintergrund weiterlaufen" IsChecked="{Binding Settings.CloseToTray}" Margin="0,4,0,0" />
                                        <CheckBox Content="Beim Minimieren nur als Symbol unten rechts anzeigen" IsChecked="{Binding Settings.MinimizeToTray}" Margin="0,4,0,0" />
                                        <CheckBox Content="Hinweis unten rechts bei Telegrammereignissen, solange das Fenster ausgeblendet ist" IsChecked="{Binding Settings.TrayNotifications}" Margin="0,4,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="Welche Telegrammereignisse einen Hinweis zeigen, legst du im Reiter „Telegrammereignisse“ beim jeweiligen Ereignis fest (Haken „Hinweis unten rechts anzeigen“). Fenster wieder öffnen: Klick auf das Symbol unten rechts (ggf. unter dem Pfeil ^). Ganz beenden: Rechtsklick auf das Symbol → Beenden." />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Sicherung">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="💾 Sicherung erstellen…" Click="CreateBackup_Click" />
                                            <Button Content="Sicherung wiederherstellen…" Click="RestoreBackup_Click" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="Packt alle Einstellungen in eine Datei: Telegrammereignisse, Schnittstellen, RIC-Beschreibungen, Fenster, Design und Empfang. Praktisch für einen zweiten PC oder vor größeren Änderungen. Die Datei enthält auch Webhook-Adressen und Passwörter, also gut aufbewahren. Beim Wiederherstellen startet das Programm neu." />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Updates">
                                    <StackPanel>
                                        <TextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                                        <CheckBox Content="Beim Programmstart und zweimal am Tag nach einer neuen Version suchen" IsChecked="{Binding CheckForUpdates}" Margin="0,6,0,0" />
                                        <CheckBox Content="Neue Versionen automatisch herunterladen" IsChecked="{Binding AutoDownloadUpdates}" Margin="0,4,0,0" />
                                        <DockPanel Margin="0,8,0,0">
                                            <Button DockPanel.Dock="Left" Content="Jetzt nach Updates suchen" Command="{Binding CheckUpdatesCommand}" VerticalAlignment="Top" />
                                            <Button DockPanel.Dock="Left" Style="{StaticResource PrimaryButton}" Content="Jetzt aktualisieren" Command="{Binding OpenUpdateCommand}"
                                                    Margin="6,0,0,0" VerticalAlignment="Top" ToolTip="{Binding UpdateToolTip}"
                                                    Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="10,0,0,0" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="Fragt bei GitHub nach der neuesten veröffentlichten Version und lädt sie im Hintergrund herunter. Installiert wird erst, wenn du auf „Jetzt aktualisieren“ oder auf den Hinweis unten in der Statusleiste klickst: Das Programm wird dann ersetzt und startet neu, die Einstellungen bleiben erhalten." />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="🎨  Darstellung">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14" MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="Darstellung" Style="{StaticResource SectionTitle}" />
                                <GroupBox Header="Design">
                                    <StackPanel>
                                        <RadioButton Content="Wie Windows (hell oder dunkel, je nach Windows-Einstellung)" GroupName="theme" IsChecked="{Binding ThemeSystem}" />
                                        <RadioButton Content="Hell" GroupName="theme" Margin="0,4,0,0" IsChecked="{Binding ThemeLight}" />
                                        <RadioButton Content="Dunkel (Nachtmodus)" GroupName="theme" Margin="0,4,0,0" IsChecked="{Binding ThemeDark}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                   Text="„Wie Windows“ folgt der Einstellung unter Windows-Einstellungen → Personalisierung → Farben → App-Modus und wechselt automatisch mit." />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="Telegrammlisten">
                                    <StackPanel>
                                        <CheckBox Content="SubRIC farbig kennzeichnen" IsChecked="{Binding SubRicColors}" />
                                        <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                            <Border Background="{DynamicResource SubRicABrush}" CornerRadius="3" Padding="7,1" Margin="0,0,6,0"><TextBlock Text="{Binding SubRicLabelA}" Foreground="White" FontWeight="SemiBold" /></Border>
                                            <Border Background="{DynamicResource SubRicBBrush}" CornerRadius="3" Padding="7,1" Margin="0,0,6,0"><TextBlock Text="{Binding SubRicLabelB}" Foreground="White" FontWeight="SemiBold" /></Border>
                                            <Border Background="{DynamicResource SubRicCBrush}" CornerRadius="3" Padding="7,1" Margin="0,0,6,0"><TextBlock Text="{Binding SubRicLabelC}" Foreground="White" FontWeight="SemiBold" /></Border>
                                            <Border Background="{DynamicResource SubRicDBrush}" CornerRadius="3" Padding="7,1"><TextBlock Text="{Binding SubRicLabelD}" Foreground="White" FontWeight="SemiBold" /></Border>
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="20,4,0,0"
                                                   Text="Die SubRIC-Spalte bekommt die Farbe und jede Zeile links einen farbigen Streifen." />

                                        <TextBlock Text="Schriftgröße" Style="{StaticResource FieldLabel}" Margin="0,12,0,3" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Standard" Click="ResetFontSize_Click" Margin="10,0,0,0" />
                                            <TextBlock DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                                       Text="{Binding ListFontSize, StringFormat={}{0:0.#} pt}" />
                                            <Slider Minimum="9" Maximum="28" TickFrequency="0.5" IsSnapToTickEnabled="True" SmallChange="0.5" LargeChange="2"
                                                    Value="{Binding ListFontSize}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Hint}"
                                                   Text="Gilt für alle Fenster im Reiter Telegramme. Tipp: Strg + Mausrad über einer Liste ändert die Größe ebenfalls." />
                                    </StackPanel>
                                </GroupBox>

                                <GroupBox Header="SubRIC-Schreibweise">
                                    <StackPanel>
                                        <RadioButton Content="groß (A, B, C, D)" IsChecked="{Binding LowercaseSubRic, Converter={StaticResource Not}}" />
                                        <RadioButton Content="klein (a, b, c, d)" Margin="0,4,0,0" IsChecked="{Binding LowercaseSubRic}" />
                                        <TextBlock Style="{StaticResource Hint}" Text="Gilt für die Anzeige unter Telegramme und für {subric} beim Senden. Fest: {subric_upper} / {subric_lower}." />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="📄  Aufzeichnung">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14" MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="Aufzeichnung" Style="{StaticResource SectionTitle}" />
                                <GroupBox Header="Aufzeichnung">
                                    <StackPanel>
                                        <CheckBox Content="Empfangene Meldungen als CSV-Tagesdatei speichern" IsChecked="{Binding Settings.LogToCsv}" />
                                        <TextBlock Text="Speicherort" Style="{StaticResource FieldLabel}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Standard" Click="ResetLogDirectory_Click" Margin="6,0,0,0"
                                                    ToolTip="Zurück zum Standardordner im Benutzerprofil" />
                                            <Button DockPanel.Dock="Right" Content="…" MinWidth="30" Click="BrowseLogDirectory_Click" Margin="6,0,0,0"
                                                    ToolTip="Ordner auswählen" />
                                            <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=LostFocus}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,6,0,0">
                                            <Button DockPanel.Dock="Right" Content="Ordner öffnen" Command="{Binding OpenLogFolderCommand}" Margin="6,0,0,0" />
                                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                                       Text="Pro Tag eine Datei pocsag-JJJJ-MM-TT.csv. Auch ein Netzlaufwerk ist möglich." />
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Speicherplatz">
                                    <StackPanel>
                                        <CheckBox Content="Abgeschlossene Tage komprimieren (.csv.gz, braucht nur etwa ein Achtel des Platzes)" IsChecked="{Binding LogCompress}" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,0"
                                                   Text="Der heutige Tag bleibt eine normale CSV-Datei. Ältere Tage durchsucht der Reiter Verlauf genauso, und von dort lassen sie sich als Excel-Datei speichern. Von Hand öffnen geht z. B. mit 7-Zip." />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Tagesdateien löschen nach" VerticalAlignment="Center" />
                                            <TextBox Width="55" Margin="6,0" Text="{Binding LogKeepDays, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="Tagen (0 = alles behalten)" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <DockPanel Margin="0,10,0,0">
                                            <Button DockPanel.Dock="Left" Content="Jetzt aufräumen" Command="{Binding CleanUpLogsCommand}" />
                                            <TextBlock Text="{Binding LogUsageText}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="🔁  Master/Slave">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14" MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="Master/Slave" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="Zwei PCs mit je einem Stick empfangen gleichzeitig. Weitergeleitet wird nur vom Master. Der Slave fragt den Master alle 5 Sekunden ab und übernimmt die Weiterleitung, wenn der Master nicht erreichbar ist, sein Empfang steht oder er nichts mehr empfängt. Läuft der Master wieder, gibt der Slave automatisch zurück. Telegrammereignisse und Schnittstellen müssen auf beiden PCs gleich eingerichtet sein (am einfachsten per Sicherung unter „Programm“ übertragen)." />
                                <GroupBox Header="Betriebsart">
                                    <StackPanel>
                                        <RadioButton Content="Aus – dieser PC arbeitet allein" IsChecked="{Binding RedundancyOff}" GroupName="Redundancy" />
                                        <RadioButton Content="Master – dieser PC leitet weiter, der Slave ist Ersatz" IsChecked="{Binding IsMaster}" GroupName="Redundancy" Margin="0,4,0,0" />
                                        <RadioButton Content="Slave – dieser PC springt ein, wenn der Master ausfällt" IsChecked="{Binding IsSlave}" GroupName="Redundancy" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding OwnAddresses, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Verbindung">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Master-PC (nur am Slave)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox Grid.Column="1" Width="220" HorizontalAlignment="Left" Text="{Binding RedundancyMaster, UpdateSourceTrigger=LostFocus}"
                                                 IsEnabled="{Binding IsSlave}" ToolTip="Im selben Netz: Rechnername oder IP-Adresse, z. B. 192.168.178.20. In verschiedenen Netzen: die Tailscale-Adresse des Masters (100.…) oder sein Tailscale-Name." />
                                        <TextBlock Grid.Row="1" Text="Port" VerticalAlignment="Center" Margin="0,6,12,0" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Width="80" HorizontalAlignment="Left" Margin="0,6,0,0" Text="{Binding RedundancyPort, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Auf beiden PCs gleich. Die Windows-Firewall am Master muss ihn zulassen (beim ersten Start als Master fragt Windows nach)." />
                                        <TextBlock Grid.Row="2" Text="Kennwort" VerticalAlignment="Center" Margin="0,6,12,0" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,6,0,0" Text="{Binding RedundancyKey, UpdateSourceTrigger=LostFocus}"
                                                 ToolTip="Auf beiden PCs gleich. Mit Kennwort ist die Verbindung verschlüsselt (AES), und nur wer es kennt, bekommt eine Antwort. Das Kennwort selbst wird nie übertragen." />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Übernahme durch den Slave">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Übernehmen, wenn der Master seit" VerticalAlignment="Center" />
                                            <TextBox Width="45" Margin="6,0" Text="{Binding FailoverSeconds, UpdateSourceTrigger=LostFocus}" />
                                            <TextBlock Text="Sekunden ausgefallen ist" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <CheckBox Content="Alarme, die der Master nicht empfangen hat, vom Slave senden" IsChecked="{Binding FailoverSendMissed}" Margin="0,8,0,0" />
                                        <TextBlock Style="{StaticResource Hint}" Margin="20,2,0,0"
                                                   Text="Der Slave fragt 8 Sekunden nach jedem Treffer beim Master nach, ob er die Meldung auch hat. Fehlt sie dort (z. B. schlechter Empfang am Master) oder ist der Master nicht erreichbar, sendet der Slave sie selbst. So geht kein Alarm verloren, auch nicht in den Sekunden bis zur Übernahme." />
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="Fällt der Master aus, meldet der Slave das wie einen Fehler (Einstellungen unter „Fehlermeldungen“). Der Master meldet umgekehrt, wenn sich der Slave nicht mehr meldet." />
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Header="Zustand">
                                    <StackPanel>
                                        <TextBlock Text="{Binding RedundancyStatus}" TextWrapping="Wrap" />
                                        <Button Content="Verbindung testen" Command="{Binding TestRedundancyCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="⚠  Fehlermeldungen">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14" MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="Fehlermeldungen" Style="{StaticResource SectionTitle}" />
                                <GroupBox Header="Fehlermeldungen">
                                    <StackPanel>
                                        <CheckBox x:Name="ErrorNotifyBox" Content="Bei Fehlern benachrichtigen" IsChecked="{Binding Settings.ErrorNotify}" FontWeight="SemiBold" />
                                        <StackPanel Margin="20,6,0,0" IsEnabled="{Binding IsChecked, ElementName=ErrorNotifyBox}">
                                            <TextBlock Text="Melden, wenn …" Foreground="{DynamicResource MutedBrush}" />
                                            <CheckBox Content="der Empfang abbricht oder nicht startet (z. B. Stick abgezogen)" IsChecked="{Binding Settings.ErrorOnDecoder}" Margin="0,4,0,0" />
                                            <CheckBox Content="das Senden an eine Schnittstelle fehlschlägt" IsChecked="{Binding Settings.ErrorOnSend}" Margin="0,4,0,0" />
                                            <CheckBox Content="die CSV-Datei nicht geschrieben werden kann" IsChecked="{Binding Settings.ErrorOnCsv}" Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="keine Meldung empfangen wurde seit" VerticalAlignment="Center" />
                                                <TextBox Width="45" Margin="6,0" Text="{Binding ErrorSilenceMinutes}" />
                                                <TextBlock Text="Minuten (0 = aus)" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Text="Benachrichtigen über …" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" />
                                            <CheckBox Content="Hinweis unten rechts" IsChecked="{Binding Settings.ErrorTray}" Margin="0,4,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="Schnittstelle" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <ComboBox Width="200" ItemsSource="{Binding ErrorTargetChoices}" SelectedItem="{Binding ErrorTarget}"
                                                          ToolTip="Der Fehler wird mit der Body-Vorlage dieser Schnittstelle gesendet: {message} enthält den Fehlertext, {rule} ist „Systemfehler“, {ric} ist 0000000." />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="Gleiche Fehler werden höchstens alle 10 Minuten gemeldet. Alle Fehler stehen zusätzlich im Protokoll." />
                                        </StackPanel>
                                        <CheckBox Content="Empfang nach einem Abbruch automatisch neu starten (alle 30 Sekunden versuchen)" IsChecked="{Binding Settings.AutoRestart}" Margin="0,10,0,0" />
                                        <Button Content="Fehlermeldung testen" Command="{Binding TestErrorCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="🧪  Testnachricht">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="18,14" MaxWidth="780" HorizontalAlignment="Left">
                                <TextBlock Text="Testnachricht" Style="{StaticResource SectionTitle}" />
                                <GroupBox Header="Testnachricht">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,6"
                                                   Text="Erzeugt eine Meldung wie vom Funk, ohne SDR-Stick. Sie erscheint unter Telegramme und läuft durch Beschreibungen, Telegrammereignisse und Schnittstellen wie eine echte Meldung. Vor dem Senden kommt eine Sicherheitsabfrage." />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="RIC" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBox Width="110" FontFamily="Consolas" Text="{Binding SimRic, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Text="SubRIC" VerticalAlignment="Center" FontWeight="SemiBold" Margin="14,0,6,0" />
                                                <ComboBox Width="60" ItemsSource="{Binding SimSubRicChoices}" SelectedItem="{Binding SimSubRic}" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="1" Text="Beschreibung" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,8,0,0" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SimDescription}" Foreground="{DynamicResource InfoTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="2" Text="Text" VerticalAlignment="Top" FontWeight="SemiBold" Margin="0,12,0,0" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Height="50" TextWrapping="Wrap" AcceptsReturn="False"
                                                     VerticalContentAlignment="Top" Text="{Binding SimText, UpdateSourceTrigger=PropertyChanged}" />
                                            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="Einspeisen" Command="{Binding SimulateCommand}" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Text="Text leer = reiner Ton-Alarm." />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                                                   Text="Dieselben Werte nutzt auch „Testnachricht senden“ im Reiter Schnittstellen." />
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
                </DockPanel>
            </TabItem>

            <!-- ============================ PROTOKOLL ============================ -->
            <TabItem Header="Protokoll">
                <DockPanel Margin="12,10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Leeren" Command="{Binding ClearLogCommand}" />
                        <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                                   Text="Ausgaben von rtl_fm / multimon-ng, Start/Stopp und Ergebnisse der Schnittstellen." />
                    </StackPanel>
                    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Netzwerk-Mitschnitt" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox Width="60" Text="{Binding CapturePort}" IsEnabled="{Binding IsCapturing, Converter={StaticResource Not}}" />
                            <Button Margin="8,0,0,0" Command="{Binding ToggleCaptureCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="Mitschnitt starten" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCapturing}" Value="True">
                                                <Setter Property="Content" Value="Mitschnitt beenden" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="10,0,0,0"
                                       Text="Nimmt Verbindungen an (z. B. BosMon-Netzwerkereignis) und zeigt, was ankommt. Wird auch in logs\mitschnitt.txt gespeichert." />
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="12" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
