<UserControl x:Class="PocsagDecoder.App.MessagePaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="#CCC" BorderThickness="1" Margin="3" Background="White">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#F7F7F7" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ColumnsButton" Content="Spalten ▾" Click="ColumnsButton_Click"
                            ToolTip="Spalten dieses Fensters ein- oder ausblenden (auch per Rechtsklick auf die Spaltenköpfe)" />
                    <Button Content="✕" MinWidth="28" Command="{Binding RemoveCommand}" ToolTip="Dieses Fenster schließen" />
                </StackPanel>
                <WrapPanel>
                    <TextBox Width="140" FontWeight="SemiBold" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Name dieses Fensters" Margin="0,2,8,2" />
                    <TextBlock Text="RIC:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Width="110" Text="{Binding Ric, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                             ToolTip="Teil einer RIC, oder Muster wie 12345*, 1000000-1000999, 111,222" />
                    <TextBlock Text="SubRIC:" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <ComboBox Width="60" ItemsSource="{Binding SubRicChoices}" SelectedItem="{Binding SubRic}" Margin="0,2" />
                    <TextBlock Text="Bezeichnung/Ort:" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox Width="140" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                             ToolTip="Sucht in Bezeichnung, Bezeichnung kurz, Ort und SubRIC-Bedeutung. Mehrere Begriffe mit | trennen (einer muss passen)." />
                    <TextBlock Text="Text:" VerticalAlignment="Center" Margin="8,0,4,0" />
                    <TextBox Width="140" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,2"
                             ToolTip="Sucht im Nachrichtentext" />
                    <CheckBox Content="nur Regeltreffer" IsChecked="{Binding OnlyMatched}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    <TextBlock VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#555">
                        <Run Text="{Binding VisibleCount, Mode=OneWay}" /><Run Text=" angezeigt" />
                    </TextBlock>
                </WrapPanel>
            </DockPanel>
        </Border>
        <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEE"
                  SelectionMode="Single" EnableRowVirtualization="True">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Matched}" Value="True">
                            <Setter Property="Background" Value="#E6F4EA" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasError}" Value="True">
                            <Setter Property="Background" Value="#FDECEA" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Regel aus dieser Nachricht erstellen" Command="{Binding Main.RuleFromMessageCommand}" />
                    <MenuItem Header="Beschreibung für diese RIC bearbeiten" Command="{Binding Main.DescriptionFromMessageCommand}" />
                    <MenuItem Header="Zeile kopieren" Click="CopyMessage_Click" />
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeit" Binding="{Binding Timestamp, StringFormat='dd.MM. HH:mm:ss'}" Width="110" />
                <DataGridTextColumn Header="RIC" Binding="{Binding Ric}" Width="80" FontFamily="Consolas" FontWeight="SemiBold" />
                <DataGridTextColumn Header="SubRIC" Binding="{Binding SubRic}" Width="55" FontFamily="Consolas" FontWeight="SemiBold" />
                <DataGridTextColumn Header="Bezeichnung" Binding="{Binding RicDescription}" Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#1A4D8F" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Ort" Binding="{Binding RicLocation}" Width="110" />
                <DataGridTextColumn Header="Bezeichnung kurz" Binding="{Binding RicShortName}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Foreground" Value="#1A4D8F" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="SubRIC-Bedeutung" Binding="{Binding SubRicDescription}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Foreground" Value="#8A3B00" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Fkt." Binding="{Binding Function}" Width="40" />
                <DataGridTextColumn Header="Baud" Binding="{Binding Baud}" Width="50" />
                <DataGridTextColumn Header="Typ" Binding="{Binding Type}" Width="65" />
                <DataGridTextColumn Header="Text" Binding="{Binding Text}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Weiterleitung" Binding="{Binding Forwarding}" Width="260">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Foreground" Value="#444" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
    </Border>
</UserControl>
